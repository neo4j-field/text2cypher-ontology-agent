OPENAI_API_KEY=...
# Optional: model used by the agent (default: gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna
# Optional: reasoning effort for the agent (none, low, medium, high, xhigh, max)
# OPENAI_REASONING_EFFORT=medium
# Optional: model used by the RAGAS judge (default: gpt-6-sol)
# JUDGE_MODEL=gpt-6-sol
# Optional: expose the ontology tool to the agent (default: true).
# Set to false to run the raw-schema baseline for the A/B comparison.
# WITH_ONTOLOGY=true
NEO4J_USERNAME=recommendations
NEO4J_PASSWORD=recommendations
NEO4J_URI="neo4j+s://demo.neo4jlabs.com"
NEO4J_DATABASE=recommendations
# Optional: path to the ontology document exposed by the get_ontology tool
# (defaults to ontology/movies.ontology.yaml)
# ONTOLOGY_FILE=/path/to/your/ontology.yaml
# Optional: where the get_ontology tool reads the ontology from —
# 'file' (default) or 'db' (CALL db.ontology.get(), once your Neo4j supports it)
# ONTOLOGY_SOURCE=file